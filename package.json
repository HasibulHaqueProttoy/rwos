{
  "name": "rwos",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm services:up && turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @rwos/db generate",
    "db:migrate": "pnpm --filter @rwos/db migrate",
    "db:seed": "pnpm --filter @rwos/core seed --sample",
    "db:seed:reference": "pnpm --filter @rwos/core seed",
    "services:up": "docker compose up -d --wait postgres redis minio mailpit && docker compose run --rm minio-init",
    "services:down": "docker compose down",
    "services:reset": "docker compose down -v && pnpm services:up",
    "staff:create": "pnpm --filter @rwos/core staff:create"
  },
  "devDependencies": {
    "@rwos/config": "workspace:*",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}

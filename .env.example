# Copy to .env.local (git-ignored): cp .env.example .env.local
#
# Rule (docs/SECURITY.md): real secrets and provider keys are listed by name only, with no value.
# The values below are throwaway local defaults that match docker-compose.yml. They only work
# against your own Docker containers and are not secrets.

NODE_ENV=development

# Apps
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Postgres 16 (Docker). Host port 5433 avoids a clash with a local Postgres on 5432.
DATABASE_URL=postgres://rwos:rwos_local_only@localhost:5433/rwos

# Redis (Docker)
REDIS_URL=redis://localhost:6379

# File storage: MinIO locally, any S3-compatible service elsewhere.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=rwos-local
S3_ACCESS_KEY_ID=rwos_local
S3_SECRET_ACCESS_KEY=rwos_local_only
S3_FORCE_PATH_STYLE=true

# Email: Mailpit catches everything locally (inbox at http://localhost:8025).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@rocketwave.local

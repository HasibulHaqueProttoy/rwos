{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {},
    "typecheck": {},
    "test": {
      "outputs": ["coverage/**"]
    },
    "test:integration": {
      "cache": false,
      "passThroughEnv": ["DATABASE_URL", "NODE_ENV", "SMTP_HOST", "SMTP_PORT", "MAILPIT_API_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
